{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend (Flask)",
      "type": "shell",
      "command": "flask run --host=0.0.0.0 --debug",
      "options": {
        "cwd": "${workspaceFolder}/"
      },
      "presentation": {
        "group": "server",
        "reveal": "always"
      },
      "runOptions": {
        "runOn": "folderOpen" 
      }
    },
    {
      "label": "Start Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "group": "server",
        "reveal": "always"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}